# StudySync Backend Environment Variables

# Node environment (production / development)
NODE_ENV=production

# Server Port (Render sets this dynamically)
PORT=5000

# MongoDB Connection String (MongoDB Atlas in production)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/studysync?retryWrites=true&w=majority

# Redis Connection String (Redis Cloud in production)
REDIS_URL=redis://default:<password>@<redis-cloud-host>:<port>

# JWT Authentication Secret (Minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# JWT Token Expiry
JWT_EXPIRY=7d

# Frontend Client URL (Your Vercel deployment URL)
CLIENT_URL=https://your-studysync-app.vercel.app

# Optional: Cloudinary Cloud Object Storage (for persistent images & PDFs in production)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
