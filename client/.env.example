# StudySync Frontend Production Environment Variables (Vercel)
# In production on Vercel, set these in Project Settings -> Environment Variables

# Backend API URL (e.g. your deployed Render service URL)
VITE_API_URL=https://your-studysync-backend.onrender.com

# Backend WebSocket URL (e.g. your deployed Render service URL)
VITE_SOCKET_URL=https://your-studysync-backend.onrender.com
